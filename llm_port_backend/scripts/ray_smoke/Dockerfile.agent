# Ray-migration smoke image: the node agent's pinned Ray stack + GPU vLLM.
# Agent source is NOT baked in; it is bind-mounted at /src so the repo code
# under test runs unmodified.
FROM python:3.12-slim
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive
# gcc/libc-dev: Triton JIT-compiles launcher stubs at runtime.
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev curl procps \
 && rm -rf /var/lib/apt/lists/*
# Pinned stack exactly as ray[llm]==2.58.0 resolves it (vllm 0.26.0) — the
# same set the agent's ``llm`` extra installs on GPU nodes.
RUN pip install "ray[serve,llm]==2.58.0"
# Agent runtime deps (llm_port_node_agent/pyproject.toml).
RUN pip install "httpx>=0.27,<1.0" "psutil>=5.9,<8.0" "websockets>=12,<16" "jinja2>=3.1,<4"
ENV PYTHONPATH=/src
WORKDIR /work
